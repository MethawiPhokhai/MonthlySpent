  "cards": [
    {
      "dot": "emerald",
      "title": "Repo as the database",
      "items": [
        "data/budget.json is the only store — the browser reads and writes it through the GitHub Contents API",
        "No backend and no database: a page reload shows exactly the last commit",
        "The PUT closes the loop: each save is a real commit on master",
        "localStorage holds only the token/config and the theme"
      ]
    },
    {
      "dot": "rose",
      "title": "Trust boundary",
      "items": [
        "The PAT lives in localStorage and travels as an Authorization header on every read and write",
        "It needs Contents read+write, so a leaked token is write access to the budget file",
        "The Contents API is the only network dependency; GitHub Pages serves the static build"
      ]
    },
    {
      "dot": "amber",
      "title": "Conflict and ordering",
      "items": [
        "PUT carries the sha of the last known revision",
        "A 409 means the remote moved: useBudget reloads the remote version instead of overwriting it",
        "auto-save compares data against the last persisted snapshot, so an unchanged render never writes",
        "Edits never touch the API directly: the UI calls useBudget mutators and the effect persists"
      ]
    }
  ]
